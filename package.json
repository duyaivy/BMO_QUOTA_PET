{
  "name": "bmo-personal",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24.18.0 <25",
    "pnpm": ">=11.24.0 <12"
  },
  "scripts": {
    "dev": "tsx scripts/serve.ts --dev",
    "build": "next build --webpack",
    "start": "tsx scripts/serve.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write src tests collector scripts/*.ts *.json *.mjs *.ts *.mts README.md AGENTS.md",
    "format:check": "prettier --check src tests collector scripts/*.ts *.json *.mjs *.ts *.mts README.md AGENTS.md",
    "test": "playwright test",
    "test:integration": "playwright test",
    "test:unit": "vitest run",
    "db:migrate": "node --conditions=react-server --import tsx scripts/db-migrate.ts",
    "fixture:enroll": "node --conditions=react-server --import tsx scripts/enroll-fixture.ts",
    "collector": "tsx collector/src/cli.ts",
    "collector:native": "tsx collector/src/native-cli.ts",
    "collector:enroll": "node --conditions=react-server --import tsx scripts/enroll-native.ts",
    "enroll:native": "BMO_ALLOW_NATIVE_SETUP=true node --conditions=react-server --import tsx scripts/enroll-native.ts native-collector-agy native-key-agy antigravity"
  },
  "dependencies": {
    "@libsql/client": "0.18.0",
    "@next/env": "16.4.3",
    "@radix-ui/react-slot": "1.5.0",
    "argon2": "0.45.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.4",
    "iron-session": "9.0.1",
    "lucide-react": "1.64.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.3",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
