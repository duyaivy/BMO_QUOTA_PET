<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.bmo-personal.collector</string>
  <key>ProgramArguments</key>
  <array>
    <string>/ABSOLUTE/NODE/BIN/node</string>
    <string>--disable-warning=ExperimentalWarning</string>
    <string>--import</string>
    <string>/ABSOLUTE/REPO/node_modules/tsx/dist/loader.mjs</string>
    <string>/ABSOLUTE/REPO/collector/src/native-cli.ts</string>
    <string>/ABSOLUTE/PRIVATE/collector-native.local.json</string>
  </array>
  <key>WorkingDirectory</key><string>/ABSOLUTE/REPO</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/ABSOLUTE/NODE/BIN:/ABSOLUTE/PROVIDER/BIN:/usr/bin:/bin</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>ProcessType</key><string>Background</string>
  <key>StandardOutPath</key><string>/dev/null</string>
  <key>StandardErrorPath</key><string>/dev/null</string>
</dict>
</plist>
