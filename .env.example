# Local Phase 1 configuration. Copy to .env.local; never commit local secrets.
# No provider credentials, MQTT, cron, or production accounts are needed.
BMO_APP_ORIGIN=http://127.0.0.1:3000
TURSO_DATABASE_URL=file:./.data/bmo.db
TURSO_AUTH_TOKEN=
# Generate locally from bounded stdin with pnpm exec tsx scripts/auth-hash.ts.
ADMIN_PASSWORD_HASH=
# Independent random secret, at least 32 characters. Keep stable across app restarts.
SESSION_SECRET=
# Explicit opt-in for local `pnpm start` (production build, disposable local disk).
BMO_ALLOW_LOCAL_DATABASE=true
# Phase 1C: key ID -> distinct random 32-byte lowercase-hex BMO secret.
BMO_INGEST_KEYS_JSON={}
# Enable only during deliberate synthetic enrollment into a local file DB.
BMO_ALLOW_FIXTURE_SETUP=false
# Phase 2: enable only during explicit native enrollment into a local file DB.
# Uses independent BMO keys; never provider credentials. Leaves verification unverified.
BMO_ALLOW_NATIVE_SETUP=false
# Optional MQTT broker. /status checks CONNECT/CONNACK without publishing.
# Leave host empty when MQTT is not configured. Server-only publisher credentials.
MQTT_HOST=
MQTT_PORT=8883
MQTT_USE_TLS=true
MQTT_USERNAME=
MQTT_PASSWORD=
